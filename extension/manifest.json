{
  "manifest_version": 3,
  "name": "Silver Back",
  "version": "0.1.0",
  "author": "Wesley Siebenthal",
  "description": "Switches away from listed browser tabs when Silver Back reports someone approaching.",
  "minimum_chrome_version": "109",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Silver Back",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "silverback@wsiebenthal.github.io",
      "strict_min_version": "128.0"
    }
  }
}
